{
	"name": "@iris/desktop",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"description": "IRIS 桌面壳（MyGo + WebView2）：Live2D 大肥鱼 + 字幕 + 打字，脑子在 server/daemon.mjs",
	"scripts": {
		"dev": "mygo dev",
		"build": "mygo build",
		"generate": "mygo generate",
		"dev:web": "vite",
		"build:web": "tsc --noEmit && vite build",
		"typecheck": "tsc --noEmit",
		"daemon": "node server/daemon.mjs"
	},
	"dependencies": {
		"@naari3/pixi-live2d-display": "1.2.5",
		"mygo-runtime": "^0.8.3",
		"pixi.js": "8.22.0"
	},
	"devDependencies": {
		"mygo-cli": "^0.8.3",
		"typescript": "^7",
		"vite": "^8"
	}
}
